rules_version = '2';

// Firebase 콘솔 → Firestore Database → 규칙 탭에 그대로 붙여넣고 "게시"
// 로그인 없이 누구나 쓸 수 있음 (운영진 결정). 대신 정해진 문서·필드 형태만 허용해 엉뚱한 데이터가 쌓이는 것을 막음.
// 데이터가 지워지면 백오피스 "기존 데이터 가져오기"로 site.json 시점 데이터 복구 가능
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/main {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['year', 'yearSteps', 'prizes'])
        && request.resource.data.year is int
        && request.resource.data.prizes is list
        && request.resource.data.prizes.size() <= 200;
    }

    match /projects/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['image', 'subtitle', 'name', 'url', 'order'])
        && request.resource.data.image is string
        && request.resource.data.image.matches('data:image/.*')
        && request.resource.data.subtitle is string
        && request.resource.data.name is string
        && request.resource.data.order is number;
    }
  }
}
